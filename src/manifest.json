{
  "manifest_version": 3,
  "name": "Level 67 for Dynamics 365 / Power Apps",
  "short_name": "Level 67",
  "version": "1.0.1",
  "description": "A command palette of power tools for Dynamics 365 and Power Apps: logical names, god mode, impersonation, Web API and more.",
  "homepage_url": "https://github.com/Purgator/CrmLevel67",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Level 67",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Open the Level 67 palette"
    }
  },
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite", "declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "*://*.dynamics.com/*",
    "*://*.microsoftdynamics.us/*",
    "*://*.appsplatform.us/*",
    "*://*.dynamics.cn/*"
  ],
  "optional_host_permissions": ["*://*/*"]
}
